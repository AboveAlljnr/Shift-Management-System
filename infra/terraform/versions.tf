terraform {
  required_version = ">= 1.9.0, < 2.0.0"

  required_providers {
    aws = {
      source  = "hashicorp/aws"
      version = "~> 5.50"
    }
    random = {
      source  = "hashicorp/random"
      version = "~> 3.6"
    }
  }

  # Local backend for this implementation phase. A remote (S3/DynamoDB) backend
  # will be introduced only once the deployment platform is being stood up.
  backend "local" {}
}
