# =============================================================================
# Shift Management System — API environment
# Copy to `.env` (and optionally `.env.local`) and adjust. Do NOT commit `.env`.
# Variable names below are the ONLY ones the application reads. The ConfigModule
# validates this file at startup (see src/config/env.validation.ts) and fails
# fast on invalid or insecure values.
# =============================================================================

# --- Environment / port ------------------------------------------------------
# development | test | staging | production
NODE_ENV="development"
# Port the API HTTP server listens on (was previously (incorrectly) "PORT").
APP_PORT=3001

# --- Database (PostgreSQL) -----------------------------------------------------
DATABASE_URL="postgresql://sms:secret@localhost:5434/sms_dev?schema=public"
# Used by Prisma migrate dev for shadow database (dev only; not consumed by the app).
DATABASE_SHADOW_URL="postgresql://sms:secret@localhost:5434/sms_shadow?schema=public"
# Startup DB-connect resilience (HIGH #5): bounded exponential backoff if Postgres is briefly
# unreachable at boot (avoids crash-looping). Optional; defaults: 10 attempts, 500ms -> 30s.
# DB_CONNECT_MAX_RETRIES=10
# DB_CONNECT_INITIAL_DELAY_MS=500
# DB_CONNECT_MAX_DELAY_MS=30000

# --- Redis (BullMQ + readiness ping) ------------------------------------------
# Single connection URL (was previously two vars REDIS_HOST/REDIS_PORT/REDIS_PASSWORD).
REDIS_URL="redis://localhost:6379"

# --- JWT ----------------------------------------------------------------------
# Production/staging REQUIRES unique secrets of >=16 chars that are NOT the committed
# dev defaults below. The API refuses to boot in production with a weak/known secret.
JWT_ACCESS_SECRET="sms-super-secret-jwt-access-key-for-dev-environment-12345"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="sms-super-secret-jwt-refresh-key-for-dev-environment-67890"
JWT_REFRESH_EXPIRES_IN="7d"

# --- CORS ----------------------------------------------------------------------
# Comma-separated list of allowed browser origins. Empty list === deny all origins
# (browser clients are blocked; non-browser/API clients still work). Production
# REQUIRES an explicit, wildcard-free list or the API will not boot.
ALLOWED_ORIGINS="http://localhost:3000"

# --- S3 / MinIO storage ---------------------------------------------------------
# Only needed if document storage is exercised in this environment. When unset in
# production, verify storage features ahead of launch (documents are a documented
# MVP gap and currently unused at runtime — see docs/10-delivery/mvp-status.md).
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
