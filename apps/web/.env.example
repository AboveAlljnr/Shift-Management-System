# =============================================================================
# Shift Management System — Web (Next.js) environment
# Copy to `.env.local` and adjust. Do NOT commit real secrets.
# =============================================================================

# API base URL, inlined into the client bundle at BUILD time by Next.js.
# - Local development: optional — omit to default to http://localhost:3001 (the API dev port).
# - Production/STAGING: REQUIRED. next.config.js fails the build if it is missing, so the
#   web client can never silently point at the wrong server. Set the real API origin, e.g.
#   https://api.example.com (or the staging API origin).
# Pass to `docker build` as a build-arg for deployable images:
#   --build-arg NEXT_PUBLIC_API_URL=https://api.example.com
NEXT_PUBLIC_API_URL=http://localhost:3001
