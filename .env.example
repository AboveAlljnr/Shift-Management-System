# ===========================================================
# Shift Management System — Environment Variables Template
# Copy to .env and fill in real values before running.
# ===========================================================

# ---- App ----
NODE_ENV=development
APP_PORT=3001
APP_URL=http://localhost:3001
WEB_URL=http://localhost:3000

# ---- Web (frontend) ----
# API base URL inlined into the web client at BUILD time. MUST be set explicitly for
# production/staging builds (next.config.js fails the build if missing). Local dev may
# leave unset (defaults to http://localhost:3001). Provide to `docker build` as a build-arg.
NEXT_PUBLIC_API_URL=http://localhost:3001

# ---- Database ----
DATABASE_URL=postgresql://sms:secret@localhost:5432/sms_dev
DATABASE_SHADOW_URL=postgresql://sms:secret@localhost:5432/sms_shadow
# Startup DB-connect resilience: bounded exponential backoff at boot (optional, sane defaults).
# DB_CONNECT_MAX_RETRIES=10
# DB_CONNECT_INITIAL_DELAY_MS=500
# DB_CONNECT_MAX_DELAY_MS=30000

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- JWT ----
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=7d

# ---- S3 / Object Storage ----
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=sms-dev
S3_REGION=us-east-1

# ---- Optimizer service ----
OPTIMIZER_URL=http://localhost:8000

# ---- LLM (optional) ----
OPENAI_API_KEY=

# ---- Sentry ----
SENTRY_DSN=

# ---- CORS ----
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
